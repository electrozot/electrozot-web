# ============================================
# ELECTROZOT PERFORMANCE OPTIMIZATION
# ============================================

# Enable Rewrite Engine
RewriteEngine On

# ============================================
# PERFORMANCE OPTIMIZATIONS
# ============================================

# Enable Gzip Compression for faster loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    
    # Compress fonts
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE font/truetype
    AddOutputFilterByType DEFLATE font/opentype
</IfModule>

# Browser Caching - Reduces server load and improves speed
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images - Cache for 1 month
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS and JavaScript - Cache for 1 month
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    
    # Fonts - Cache for 1 year
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/truetype "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    
    # Documents - Cache for 1 week
    ExpiresByType application/pdf "access plus 1 week"
    ExpiresByType application/x-shockwave-flash "access plus 1 month"
    
    # HTML and PHP - Cache for 2 hours (dynamic content)
    ExpiresByType text/html "access plus 2 hours"
    
    # Default cache time
    ExpiresDefault "access plus 1 week"
</IfModule>

# Cache Control Headers for better performance
<IfModule mod_headers.c>
    # Cache static assets for 30 days
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=2592000, public"
        Header set Expires "Thu, 31 Dec 2025 20:00:00 GMT"
    </FilesMatch>
    
    # Cache HTML and PHP for 2 hours
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "max-age=7200, private, must-revalidate"
        Header append Vary "Accept-Encoding"
    </FilesMatch>
    
    # Don't cache dynamic booking and admin pages
    <FilesMatch "(process-guest-booking|admin|api-|ajax-|check-|get-|booking)">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    
    # Sitemap and robots.txt caching
    <FilesMatch "(sitemap\.xml|sitemap-index\.xml|robots\.txt)$">
        Header set Cache-Control "max-age=86400, public"
    </FilesMatch>
</IfModule>

# Remove ETags for better caching
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# Optimize PHP Settings for better performance
<IfModule mod_php7.c>
    php_value memory_limit 256M
    php_value max_execution_time 60
    php_value max_input_vars 3000
    php_value post_max_size 32M
    php_value upload_max_filesize 32M
    php_value session.gc_maxlifetime 3600
    php_value opcache.enable 1
    php_value opcache.memory_consumption 128
</IfModule>

<IfModule mod_php8.c>
    php_value memory_limit 256M
    php_value max_execution_time 60
    php_value max_input_vars 3000
    php_value post_max_size 32M
    php_value upload_max_filesize 32M
    php_value session.gc_maxlifetime 3600
    php_value opcache.enable 1
    php_value opcache.memory_consumption 128
</IfModule>

# ============================================
# SEO FRIENDLY URLS & CANONICAL FIXES
# ============================================

# Force HTTPS (redirect HTTP to HTTPS)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Force non-WWW (redirect www to non-www for canonical URLs)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# Remove trailing slashes for canonical URLs (except for directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Remove index.php from URL for canonical consistency
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php[?\s] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Handle old URLs and redirects to prevent 404s
RewriteRule ^electrical-services/?$ /services.php [R=301,L]
RewriteRule ^appliance-repair/?$ /electronic-appliance-repair.php [R=301,L]
RewriteRule ^home-automation/?$ /installation-services.php [R=301,L]
RewriteRule ^emergency-electrical-service/?$ /services.php [R=301,L]
RewriteRule ^electrician-near-me/?$ /contact.php [R=301,L]
RewriteRule ^electrical-repair-services/?$ /electronic-appliance-repair.php [R=301,L]

# Redirect duplicate service URLs to canonical versions
RewriteRule ^services/installation/?$ /installation-services.php [R=301,L]
RewriteRule ^services/repair/?$ /electronic-appliance-repair.php [R=301,L]
RewriteRule ^services/plumbing/?$ /plumbing-solutions.php [R=301,L]
RewriteRule ^installation/?$ /installation-services.php [R=301,L]
RewriteRule ^repair/?$ /electronic-appliance-repair.php [R=301,L]
RewriteRule ^plumbing/?$ /plumbing-solutions.php [R=301,L]

# Clean URLs and canonical redirects
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Blog URLs (clean URLs)
RewriteRule ^blog/?$ /blog.php [L]
RewriteRule ^blog/([0-9]+)/([a-zA-Z0-9-]+)/?$ /blog-post.php?id=$1&slug=$2 [L]

# Remove .php extension for clean URLs (but keep internal .php files working)
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ /$1.php [NC,L]

# Redirect .php extensions to clean URLs for canonical consistency
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^?\s]*?)\.php[?\s] [NC]
RewriteRule ^(.*)\.php$ /$1 [R=301,L]

# Handle query parameters - redirect to clean URLs
RewriteCond %{QUERY_STRING} ^(.+)$
RewriteCond %{REQUEST_URI} ^/(index|about|services|contact|gallery|blog|faq|privacy-policy|installation-services|electronic-appliance-repair|plumbing-solutions)\.php$
RewriteRule ^(.*)\.php$ /$1? [R=301,L]

# Additional SEO redirects for common variations
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^index/?$ / [R=301,L]
RewriteRule ^main/?$ / [R=301,L]

# Service variations redirects
RewriteRule ^electrical/?$ /services.php [R=301,L]
RewriteRule ^electric/?$ /services.php [R=301,L]
RewriteRule ^technician/?$ /services.php [R=301,L]
RewriteRule ^repair-service/?$ /electronic-appliance-repair.php [R=301,L]
RewriteRule ^installation-service/?$ /installation-services.php [R=301,L]
RewriteRule ^plumber/?$ /plumbing-solutions.php [R=301,L]

# Contact variations
RewriteRule ^contact-us/?$ /contact.php [R=301,L]
RewriteRule ^get-in-touch/?$ /contact.php [R=301,L]
RewriteRule ^book-now/?$ /contact.php [R=301,L]

# About variations
RewriteRule ^about-us/?$ /about.php [R=301,L]
RewriteRule ^company/?$ /about.php [R=301,L]
RewriteRule ^team/?$ /about.php [R=301,L]

# Gallery variations
RewriteRule ^portfolio/?$ /gallery.php [R=301,L]
RewriteRule ^work/?$ /gallery.php [R=301,L]
RewriteRule ^projects/?$ /gallery.php [R=301,L]

# FAQ variations
RewriteRule ^help/?$ /faq.php [R=301,L]
RewriteRule ^support/?$ /faq.php [R=301,L]
RewriteRule ^questions/?$ /faq.php [R=301,L]

# Blog variations
RewriteRule ^news/?$ /blog.php [R=301,L]
RewriteRule ^articles/?$ /blog.php [R=301,L]
RewriteRule ^tips/?$ /blog.php [R=301,L]

# Privacy variations
RewriteRule ^privacy/?$ /privacy-policy.php [R=301,L]
RewriteRule ^terms/?$ /privacy-policy.php [R=301,L]

# Remove common tracking parameters to prevent duplicate content
RewriteCond %{QUERY_STRING} ^(.*)&?utm_[^&]+(.*)$ [NC]
RewriteRule ^(.*)$ /$1?%1%2 [R=301,L]

RewriteCond %{QUERY_STRING} ^(.*)&?fbclid=[^&]+(.*)$ [NC]
RewriteRule ^(.*)$ /$1?%1%2 [R=301,L]

RewriteCond %{QUERY_STRING} ^(.*)&?gclid=[^&]+(.*)$ [NC]
RewriteRule ^(.*)$ /$1?%1%2 [R=301,L]

RewriteCond %{QUERY_STRING} ^(.*)&?ref=[^&]+(.*)$ [NC]
RewriteRule ^(.*)$ /$1?%1%2 [R=301,L]

# Custom error pages
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

# Handle common 404 patterns - redirect to relevant pages
RewriteRule ^wp-admin/?.*$ /admin/ [R=301,L]
RewriteRule ^wp-content/?.*$ / [R=301,L]
RewriteRule ^wp-includes/?.*$ / [R=301,L]
RewriteRule ^wordpress/?.*$ / [R=301,L]
RewriteRule ^admin\.php$ /admin/ [R=301,L]
RewriteRule ^login\.php$ /usr/ [R=301,L]
RewriteRule ^user/?$ /usr/ [R=301,L]

# ============================================
# SECURITY MEASURES
# ============================================

# Prevent directory listing
Options -Indexes

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Protect sensitive files
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

<Files "*.log">
    Order allow,deny
    Deny from all
</Files>

<Files "performance-*.php">
    Order allow,deny
    Deny from all
</Files>

# Block access to admin files from non-admin IPs (optional)
# <FilesMatch "^(admin|api-|ajax-|check-|get-)">
#     Order deny,allow
#     Deny from all
#     Allow from 127.0.0.1
#     Allow from your.admin.ip.here
# </FilesMatch>

# ============================================
# ADDITIONAL OPTIMIZATIONS
# ============================================

# Prevent access to version control files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent access to backup files
<FilesMatch "\.(bak|backup|old|tmp|temp)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable Keep-Alive for better performance
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>
