<!-- Technician Notification System - Mobile Persistent Version -->
<script>
console.log('🚀 Initializing Mobile-Persistent Notification System v3.0');

let techNotificationAudio = null;
let audioEnabled = false;
let audioInitialized = false;
let checkCount = 0;
let persistentAudioEnabled = false;

// Unique storage key per technician to avoid conflicts
const TECH_ID = <?php echo $_SESSION['t_id']; ?>;
const AUDIO_STORAGE_KEY = `techAudio_${TECH_ID}_enabled`;
const AUDIO_SETUP_KEY = `techAudio_${TECH_ID}_setup_complete`;
const NOTIFICATION_PERMISSION_KEY = `techNotif_${TECH_ID}_permission`;

function initializeAudio() {
    console.log('🔊 [AUDIO] Initializing audio system...');
    if (!audioInitialized) {
        try {
            techNotificationAudio = new Audio('../admin/vendor/sounds/arived.mp3');
            techNotificationAudio.volume = 1.0;
            techNotificationAudio.preload = 'auto';
            techNotificationAudio.load();
            audioInitialized = true;
            console.log('✅ [AUDIO] Audio initialized successfully');
            
            // Check if audio was previously enabled for this technician
            const wasEnabled = localStorage.getItem(AUDIO_STORAGE_KEY);
            if (wasEnabled === 'true') {
                audioEnabled = true;
                persistentAudioEnabled = true;
                console.log('✅ [AUDIO] Audio was previously enabled - ready to play sounds');
            }
            
        } catch(e) {
            console.error('❌ [AUDIO] Audio initialization error:', e);
        }
    }
}

function enableAudioPermanently() {
    console.log('🔊 [AUDIO] Enabling audio permanently...');
    if (!audioInitialized) initializeAudio();
    
    if (techNotificationAudio) {
        return techNotificationAudio.play().then(() => {
            techNotificationAudio.pause();
            techNotificationAudio.currentTime = 0;
            audioEnabled = true;
            persistentAudioEnabled = true;
            
            // Save permanently for this technician
            localStorage.setItem(AUDIO_STORAGE_KEY, 'true');
            localStorage.setItem(AUDIO_SETUP_KEY, 'true');
            
            console.log('✅ [AUDIO] Audio enabled permanently and saved for technician ID:', TECH_ID);
            
            // Show success message only once
            if (!document.getElementById('audio-success-msg')) {
                showSuccessMessage();
            }
            
            return true;
        }).catch((e) => {
            console.log('⚠️ [AUDIO] Could not enable audio:', e.message);
            return false;
        });
    }
    return Promise.resolve(false);
}

function showSuccessMessage() {
    const msg = document.createElement('div');
    msg.id = 'audio-success-msg';
    msg.style.cssText = `
        position: fixed; 
        top: 80px; 
        left: 50%; 
        transform: translateX(-50%); 
        background: linear-gradient(135deg, #10b981 0%, #059669 100%); 
        color: white; 
        padding: 15px 25px; 
        border-radius: 15px; 
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.4); 
        z-index: 99999; 
        font-weight: bold; 
        display: flex; 
        align-items: center; 
        gap: 10px;
        animation: slideDown 0.5s ease-out;
    `;
    msg.innerHTML = '<i class="fas fa-check-circle" style="font-size: 20px;"></i><span>🔊 Sound Alerts Enabled Forever!</span>';
    document.body.appendChild(msg);
    
    setTimeout(() => {
        msg.style.transition = 'opacity 0.5s, transform 0.5s';
        msg.style.opacity = '0';
        msg.style.transform = 'translateX(-50%) translateY(-20px)';
        setTimeout(() => msg.remove(), 500);
    }, 3000);
}

let lastSoundPlayTime = 0;
const SOUND_COOLDOWN = 2000; // 2 seconds cooldown

function playNotificationSound() {
    console.log('🔊 [SOUND] Attempting to play notification sound...');
    
    // Prevent duplicate sounds
    const now = Date.now();
    if (now - lastSoundPlayTime < SOUND_COOLDOWN) {
        console.log('⏭️ [SOUND] Skipping - sound played recently');
        return;
    }
    
    if (!audioInitialized) initializeAudio();
    if (!techNotificationAudio) return;
    
    // If audio was previously enabled, play immediately
    if (persistentAudioEnabled || audioEnabled) {
        techNotificationAudio.currentTime = 0;
        techNotificationAudio.volume = 1.0;
        
        techNotificationAudio.play()
            .then(() => {
                console.log('✅ [SOUND] Sound played successfully!');
                lastSoundPlayTime = Date.now();
            })
            .catch((error) => {
                console.log('⚠️ [SOUND] Sound play failed:', error.message);
                // If it fails, try to re-enable audio
                if (error.name === 'NotAllowedError') {
                    showOneTimeEnablePrompt();
                }
            });
    } else {
        // First time - show enable prompt
        showOneTimeEnablePrompt();
    }
}

let enablePromptShown = false;

function showOneTimeEnablePrompt() {
    // Check if setup is already complete for this technician
    const setupComplete = localStorage.getItem(AUDIO_SETUP_KEY);
    if (setupComplete === 'true') {
        console.log('ℹ️ [PROMPT] Setup already complete, not showing prompt');
        return;
    }
    
    // Only show prompt once per session
    if (enablePromptShown || document.getElementById('audio-enable-prompt')) {
        return;
    }
    
    enablePromptShown = true;
    console.log('📢 [PROMPT] Showing one-time audio enable prompt');
    
    const prompt = document.createElement('div');
    prompt.id = 'audio-enable-prompt';
    prompt.style.cssText = `
        position: fixed; 
        top: 50%; 
        left: 50%; 
        transform: translate(-50%, -50%); 
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
        color: white; 
        padding: 30px; 
        border-radius: 20px; 
        box-shadow: 0 20px 60px rgba(0,0,0,0.4); 
        z-index: 99999; 
        text-align: center; 
        max-width: 90%; 
        width: 400px;
        animation: popIn 0.5s ease-out;
    `;
    
    prompt.innerHTML = `
        <div style="font-size: 48px; margin-bottom: 20px;">🔊</div>
        <h3 style="margin: 0 0 15px 0; font-size: 24px;">Enable Sound Alerts</h3>
        <p style="margin: 0 0 25px 0; font-size: 16px; opacity: 0.9; line-height: 1.5;">
            Get instant sound notifications for new bookings.<br>
            <strong>This will be saved permanently for your account.</strong>
        </p>
        <button id="enable-audio-btn" style="
            background: white; 
            color: #667eea; 
            border: none; 
            padding: 15px 30px; 
            border-radius: 50px; 
            font-size: 18px; 
            font-weight: bold; 
            cursor: pointer; 
            margin-right: 15px;
            transition: all 0.3s ease;
        ">
            <i class="fas fa-volume-up"></i> Enable Sound
        </button>
        <button id="skip-audio-btn" style="
            background: transparent; 
            color: white; 
            border: 2px solid white; 
            padding: 15px 30px; 
            border-radius: 50px; 
            font-size: 18px; 
            font-weight: bold; 
            cursor: pointer;
            transition: all 0.3s ease;
        ">
            Skip
        </button>
    `;
    
    document.body.appendChild(prompt);
    
    // Add backdrop
    const backdrop = document.createElement('div');
    backdrop.id = 'audio-prompt-backdrop';
    backdrop.style.cssText = `
        position: fixed; 
        top: 0; 
        left: 0; 
        width: 100%; 
        height: 100%; 
        background: rgba(0,0,0,0.7); 
        z-index: 99998;
        animation: fadeIn 0.3s ease-out;
    `;
    document.body.appendChild(backdrop);
    
    // Handle enable button
    document.getElementById('enable-audio-btn').onclick = function() {
        this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enabling...';
        this.disabled = true;
        
        enableAudioPermanently().then((success) => {
            if (success) {
                prompt.remove();
                backdrop.remove();
                
                // Play a test sound to confirm
                setTimeout(() => {
                    if (techNotificationAudio) {
                        techNotificationAudio.currentTime = 0;
                        techNotificationAudio.play().catch(() => {});
                    }
                }, 500);
            } else {
                this.innerHTML = '<i class="fas fa-exclamation-circle"></i> Try Again';
                this.disabled = false;
            }
        });
    };
    
    // Handle skip button
    document.getElementById('skip-audio-btn').onclick = function() {
        localStorage.setItem(AUDIO_SETUP_KEY, 'skipped');
        prompt.remove();
        backdrop.remove();
        console.log('ℹ️ [PROMPT] User skipped audio setup');
    };
}

// Request notification permission for mobile
function requestNotificationPermission() {
    if ('Notification' in window && Notification.permission === 'default') {
        console.log('📋 [PERMISSION] Requesting notification permission...');
        Notification.requestPermission().then(permission => {
            localStorage.setItem(NOTIFICATION_PERMISSION_KEY, permission);
            if (permission === 'granted') {
                console.log('✅ [PERMISSION] Notification permission granted!');
            } else {
                console.log('⚠️ [PERMISSION] Notification permission denied');
            }
        });
    }
}

function showNotificationToast(notifications) {
    // Only show toast if page is visible
    if (document.hidden) {
        console.log('📱 [TOAST] Page hidden, skipping toast');
        return;
    }
    
    console.log('📱 [TOAST] Showing notification toast for', notifications.length, 'notifications');
    
    const count = notifications.length;
    document.querySelectorAll('.tech-notification-toast').forEach(el => el.remove());
    
    const firstAction = notifications[0].action;
    let bgColor = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
    let icon = 'bell';
    
    if(firstAction === 'assigned' || firstAction === 'reassigned') {
        bgColor = 'linear-gradient(135deg, #11998e 0%, #38ef7d 100%)';
        icon = 'user-check';
    } else if(firstAction === 'approved') {
        bgColor = 'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)';
        icon = 'check-circle';
    } else if(firstAction === 'hold') {
        bgColor = 'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)';
        icon = 'pause-circle';
    } else if(firstAction === 'resumed') {
        bgColor = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';
        icon = 'play-circle';
    }
    
    let html = `<div class="tech-notification-toast" style="position: fixed; top: 80px; right: 20px; background: ${bgColor}; color: white; padding: 20px; border-radius: 10px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); z-index: 99999; min-width: 350px; max-width: 400px; animation: slideIn 0.5s ease-out;">`;
    html += `<div style="display: flex; align-items: center; margin-bottom: 10px;">`;
    html += `<i class="fas fa-${icon}" style="font-size: 24px; margin-right: 10px;"></i>`;
    html += `<h4 style="margin: 0; font-weight: bold;">${count === 1 ? 'New Notification!' : count + ' New Notifications!'}</h4>`;
    html += `<button onclick="this.parentElement.parentElement.remove()" style="margin-left: auto; background: transparent; border: none; color: white; font-size: 20px; cursor: pointer;">&times;</button>`;
    html += `</div>`;
    
    notifications.forEach(notif => {
        html += `<div style="background: rgba(255,255,255,0.2); padding: 10px; border-radius: 5px; margin-top: 10px;">`;
        html += `<strong>📋 Booking #${notif.id}</strong><br>`;
        html += `<div style="margin-top: 5px; font-size: 13px;">`;
        html += `<strong>✨ ${notif.message}</strong><br>`;
        html += `👤 ${notif.customer}<br>`;
        html += `📞 ${notif.phone}<br>`;
        html += `🔧 ${notif.service}<br>`;
        html += `📊 Status: ${notif.status}`;
        if(notif.deadline_date) {
            html += `<br>⏰ Deadline: ${notif.deadline_date} ${notif.deadline_time || ''}`;
        }
        html += `</div></div>`;
    });
    
    html += `<div style="margin-top: 15px; text-align: center;">`;
    html += `<a href="dashboard.php" style="background: white; color: #667eea; padding: 8px 20px; border-radius: 5px; text-decoration: none; font-weight: bold; display: inline-block;">View Dashboard</a>`;
    html += `</div></div>`;
    
    document.body.insertAdjacentHTML('beforeend', html);
    
    setTimeout(() => {
        const toast = document.querySelector('.tech-notification-toast');
        if (toast) {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(400px)';
            setTimeout(() => toast.remove(), 500);
        }
    }, 15000);
}

function showBrowserNotification(notifications) {
    if (Notification.permission !== 'granted') return;
    
    notifications.forEach(notif => {
        try {
            const notification = new Notification('🔔 New Booking Assignment!', {
                body: `Booking #${notif.id}\n🔧 ${notif.service}\n👤 ${notif.customer}\n📞 ${notif.phone}`,
                icon: '../admin/vendor/img/logo.png',
                badge: '../admin/vendor/img/logo.png',
                vibrate: [300, 100, 300, 100, 300],
                tag: 'booking-' + notif.id,
                requireInteraction: true,
                silent: false
            });
            
            notification.onclick = function() {
                window.focus();
                this.close();
            };
            
            console.log('✅ [BROWSER-NOTIF] Browser notification shown');
        } catch(e) {
            console.error('❌ [BROWSER-NOTIF] Error:', e);
        }
    });
}

function checkTechNotifications() {
    checkCount++;
    console.log(`🔍 [CHECK #${checkCount}] Starting notification check...`);
    
    fetch('check-technician-notifications.php', { method: 'GET', cache: 'no-cache' })
    .then(response => response.text())
    .then(rawResponse => {
        const cleanResponse = rawResponse.trim().replace(/^\uFEFF/, '');
        const response = JSON.parse(cleanResponse);
        
        if(response.error) {
            console.error('❌ [ERROR] Server error:', response.error);
            return;
        }
        
        // Update badge
        const badge = document.getElementById('notificationCount');
        if(badge) {
            if(response.notification_count > 0) {
                badge.textContent = response.notification_count;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }
        }
        
        if(response.has_notifications && response.new_count > 0) {
            console.log('🎉 [NOTIFICATION] NEW NOTIFICATIONS DETECTED!', response.new_count);
            
            // Play sound (works even in background if enabled)
            playNotificationSound();
            
            // Show browser notification (works when page is hidden/locked)
            showBrowserNotification(response.notifications);
            
            // Show toast only if page is visible
            if (!document.hidden) {
                showNotificationToast(response.notifications);
            }
            
            // Update UI elements
            const dot = document.getElementById('headerNotifDot');
            if(dot) dot.style.display = 'block';
            
            const mobileAlert = document.getElementById('mobileNotificationAlert');
            const mobileText = document.getElementById('mobileAlertText');
            if(mobileAlert && mobileText) {
                mobileText.textContent = `You have ${response.notification_count} new notification${response.notification_count > 1 ? 's' : ''}!`;
                mobileAlert.style.display = 'flex';
            }
        } else {
            console.log('✓ [CHECK] No new notifications');
        }
    })
    .catch(error => {
        console.error('❌ [FETCH] Error:', error);
    });
}

// Initialize system
console.log('🎬 [INIT] Initializing notification system...');
initializeAudio();

// Auto-enable audio on first user interaction (mobile-friendly)
let autoEnableAttempted = false;

function handleFirstInteraction() {
    if (autoEnableAttempted) return;
    autoEnableAttempted = true;
    
    console.log('👆 [INTERACTION] First user interaction detected');
    
    // Check if audio was previously enabled
    const wasEnabled = localStorage.getItem(AUDIO_STORAGE_KEY);
    const setupComplete = localStorage.getItem(AUDIO_SETUP_KEY);
    
    if (wasEnabled === 'true') {
        // Audio was previously enabled - enable it silently
        enableAudioPermanently().then(() => {
            console.log('✅ [INTERACTION] Audio re-enabled from previous session');
        });
    } else if (setupComplete !== 'true' && setupComplete !== 'skipped') {
        // First time - show setup prompt after a short delay
        setTimeout(() => {
            showOneTimeEnablePrompt();
        }, 1000);
    }
    
    // Request notification permission
    requestNotificationPermission();
}

// Add interaction listeners
['click', 'touchstart', 'keydown', 'scroll'].forEach(event => {
    document.addEventListener(event, handleFirstInteraction, { passive: true, once: true });
});

// Initial check
setTimeout(() => {
    fetch('check-technician-notifications.php', { cache: 'no-cache' })
        .then(response => response.json())
        .then(response => {
            if(response && response.notification_count > 0) {
                const dot = document.getElementById('headerNotifDot');
                if(dot) dot.style.display = 'block';
                const badge = document.getElementById('floatingBadge');
                if(badge) {
                    badge.textContent = response.notification_count;
                    badge.style.display = 'flex';
                }
            }
        })
        .catch(e => console.error('❌ [INIT] Initial check error:', e));
}, 1000);

// Start polling
setInterval(checkTechNotifications, 5000);
setTimeout(checkTechNotifications, 2000);

// Add CSS animations
if(!document.getElementById('tech-notification-styles')) {
    const style = document.createElement('style');
    style.id = 'tech-notification-styles';
    style.textContent = `
        @keyframes slideIn { 
            from { transform: translateX(400px); opacity: 0; } 
            to { transform: translateX(0); opacity: 1; } 
        } 
        @keyframes slideDown { 
            from { transform: translateX(-50%) translateY(-100%); opacity: 0; } 
            to { transform: translateX(-50%) translateY(0); opacity: 1; } 
        } 
        @keyframes popIn { 
            from { transform: translate(-50%, -50%) scale(0.8); opacity: 0; } 
            to { transform: translate(-50%, -50%) scale(1); opacity: 1; } 
        } 
        @keyframes fadeIn { 
            from { opacity: 0; } 
            to { opacity: 1; } 
        } 
        .tech-notification-toast { 
            transition: all 0.5s ease; 
        } 
        .tech-notification-toast:hover { 
            transform: scale(1.02); 
        }
    `;
    document.head.appendChild(style);
}

// Register service worker for background notifications
if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('service-worker.js')
        .then(registration => {
            console.log('✅ [SW] Service Worker registered for background notifications');
            
            // Request persistent notification permission
            if (Notification.permission === 'default') {
                Notification.requestPermission().then(permission => {
                    localStorage.setItem(NOTIFICATION_PERMISSION_KEY, permission);
                    if (permission === 'granted') {
                        console.log('✅ [SW] Background notification permission granted');
                        
                        // Register for background sync if supported
                        if ('sync' in window.ServiceWorkerRegistration.prototype) {
                            registration.sync.register('check-bookings');
                            console.log('✅ [SW] Background sync registered');
                        }
                        
                        // Register for periodic sync if supported (Chrome Android)
                        if ('periodicSync' in window.ServiceWorkerRegistration.prototype) {
                            registration.periodicSync.register('check-bookings', {
                                minInterval: 10000 // 10 seconds minimum
                            }).then(() => {
                                console.log('✅ [SW] Periodic background sync registered');
                            }).catch(err => {
                                console.log('ℹ️ [SW] Periodic sync not available:', err.message);
                            });
                        }
                    }
                });
            } else if (Notification.permission === 'granted') {
                console.log('✅ [SW] Background notifications already enabled');
            }
            
            // Listen for messages from service worker
            navigator.serviceWorker.addEventListener('message', event => {
                console.log('💬 [SW] Message from service worker:', event.data);
                if (event.data.type === 'NEW_BOOKING') {
                    // Service worker found new bookings, refresh our UI
                    setTimeout(checkTechNotifications, 1000);
                }
            });
            
        })
        .catch(error => {
            console.error('❌ [SW] Service Worker registration failed:', error);
        });
}

console.log('✅ Mobile-Persistent Notification System Initialized');
console.log('📊 Technician ID:', TECH_ID);
console.log('🔊 Audio Storage Key:', AUDIO_STORAGE_KEY);
console.log('📱 Polling every 5 seconds (works in background)');
console.log('🔒 Works when phone is locked and app is in background');
console.log('🔄 Service Worker handles background notifications');
</script>