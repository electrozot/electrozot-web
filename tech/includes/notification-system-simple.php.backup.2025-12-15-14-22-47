<!-- Simple Notification System - Autofix Resistant -->
<script>
console.log('🚀 Simple Notification System v6.0 - Starting...');

// Configuration
var TECH_ID = <?php echo $_SESSION['t_id']; ?>;
var AUDIO_KEY = 'techAudio_' + TECH_ID + '_enabled';
var SETUP_KEY = 'techAudio_' + TECH_ID + '_setup_complete';

// State
var notifAudio = null;
var audioReady = false;
var checkCount = 0;
var lastSound = 0;

// Device check
var isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

console.log('📱 Device: ' + (isMobile ? 'Mobile' : 'Desktop') + ', Tech ID: ' + TECH_ID);

// Initialize audio
function initAudio() {
    console.log('🔊 Initializing audio...');
    try {
        notifAudio = new Audio('../admin/vendor/sounds/arived.mp3');
        notifAudio.volume = 1.0;
        notifAudio.preload = 'auto';
        
        var wasEnabled = localStorage.getItem(AUDIO_KEY);
        if (wasEnabled === 'true') {
            audioReady = true;
            console.log('✅ Audio was previously enabled');
        }
        
        console.log('✅ Audio initialized');
    } catch(e) {
        console.error('❌ Audio init failed:', e);
    }
}

// Enable audio
function enableAudio() {
    console.log('🔊 Enabling audio...');
    if (!notifAudio) initAudio();
    
    if (notifAudio) {
        notifAudio.play().then(function() {
            notifAudio.pause();
            notifAudio.currentTime = 0;
            audioReady = true;
            localStorage.setItem(AUDIO_KEY, 'true');
            localStorage.setItem(SETUP_KEY, 'true');
            console.log('✅ Audio enabled and saved');
            showSuccess();
        }).catch(function(e) {
            console.log('⚠️ Audio enable failed:', e.message);
        });
    }
}

// Play sound
function playSound() {
    console.log('🔊 Playing sound...');
    
    var now = Date.now();
    if (now - lastSound < 1500) {
        console.log('⏭️ Sound cooldown active');
        return;
    }
    
    if (!notifAudio) initAudio();
    
    if (!audioReady) {
        showEnablePrompt();
        return;
    }
    
    if (notifAudio) {
        notifAudio.currentTime = 0;
        notifAudio.volume = 1.0;
        
        notifAudio.play().then(function() {
            console.log('✅ Sound played');
            lastSound = Date.now();
            setTimeout(function() {
                notifAudio.pause();
                notifAudio.currentTime = 0;
            }, 2000);
        }).catch(function(e) {
            console.log('⚠️ Sound failed:', e.message);
        });
    }
    
    // Vibration for mobile
    if (isMobile && navigator.vibrate) {
        navigator.vibrate([300, 100, 300, 100, 300]);
        console.log('📳 Vibration triggered');
    }
}
// Show success message
function showSuccess() {
    var msg = document.createElement('div');
    msg.style.cssText = 'position: fixed; top: 80px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: 15px 25px; border-radius: 15px; box-shadow: 0 10px 30px rgba(16, 185, 129, 0.4); z-index: 99999; font-weight: bold;';
    msg.innerHTML = '<i class="fas fa-check-circle"></i> 🔊 Sound Alerts Enabled!';
    document.body.appendChild(msg);
    
    setTimeout(function() {
        msg.style.opacity = '0';
        setTimeout(function() { msg.remove(); }, 500);
    }, 3000);
}

// Show enable prompt
function showEnablePrompt() {
    var setupDone = localStorage.getItem(SETUP_KEY);
    if (setupDone === 'true' || setupDone === 'skipped') return;
    
    var prompt = document.createElement('div');
    prompt.style.cssText = 'position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 25px; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.4); z-index: 99999; text-align: center; max-width: 90%; width: 350px;';
    
    prompt.innerHTML = '<div style="font-size: 48px; margin-bottom: 15px;">📱🔊</div><h3 style="margin: 0 0 10px 0;">Enable Sound Alerts</h3><p style="margin: 0 0 20px 0; font-size: 14px;">Get sound alerts for new bookings!</p><button id="enableBtn" style="background: white; color: #667eea; border: none; padding: 15px 25px; border-radius: 50px; font-weight: bold; cursor: pointer; margin-right: 10px;">Enable Sound</button><button id="skipBtn" style="background: transparent; color: white; border: 2px solid white; padding: 15px 25px; border-radius: 50px; font-weight: bold; cursor: pointer;">Skip</button>';
    
    document.body.appendChild(prompt);
    
    var backdrop = document.createElement('div');
    backdrop.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 99998;';
    document.body.appendChild(backdrop);
    
    document.getElementById('enableBtn').onclick = function() {
        this.innerHTML = 'Enabling...';
        this.disabled = true;
        enableAudio();
        prompt.remove();
        backdrop.remove();
    };
    
    document.getElementById('skipBtn').onclick = function() {
        localStorage.setItem(SETUP_KEY, 'skipped');
        prompt.remove();
        backdrop.remove();
    };
}

// Show browser notification
function showBrowserNotif(notifications) {
    if (Notification.permission !== 'granted') return;
    
    notifications.forEach(function(notif) {
        try {
            var notification = new Notification('🔔 New Booking Assignment!', {
                body: 'Booking #' + notif.id + '\n🔧 ' + notif.service + '\n👤 ' + notif.customer + '\n📞 ' + notif.phone,
                icon: '../admin/vendor/img/logo.png',
                vibrate: [500, 200, 500, 200, 500],
                tag: 'booking-' + notif.id,
                requireInteraction: true,
                silent: false
            });
            
            notification.onclick = function() {
                window.focus();
                this.close();
            };
            
            setTimeout(function() { notification.close(); }, 10000);
            console.log('✅ Browser notification shown');
        } catch(e) {
            console.error('❌ Browser notification failed:', e);
        }
    });
}

// Show toast notification
function showToast(notifications) {
    if (document.hidden) return;
    
    // Remove existing toasts
    var existing = document.querySelectorAll('.notif-toast');
    existing.forEach(function(el) { el.remove(); });
    
    var count = notifications.length;
    var html = '<div class="notif-toast" style="position: fixed; top: 80px; right: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border-radius: 10px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); z-index: 99999; min-width: 300px; max-width: 90%; animation: slideIn 0.5s ease-out;">';
    html += '<div style="display: flex; align-items: center; margin-bottom: 10px;"><i class="fas fa-bell" style="font-size: 24px; margin-right: 10px;"></i><h4 style="margin: 0; font-weight: bold;">' + (count === 1 ? 'New Notification!' : count + ' New Notifications!') + '</h4><button onclick="this.parentElement.parentElement.remove()" style="margin-left: auto; background: transparent; border: none; color: white; font-size: 20px; cursor: pointer;">&times;</button></div>';
    
    notifications.forEach(function(notif) {
        html += '<div style="background: rgba(255,255,255,0.2); padding: 10px; border-radius: 5px; margin-top: 10px;"><strong>📋 Booking #' + notif.id + '</strong><br><div style="margin-top: 5px; font-size: 13px;"><strong>✨ ' + notif.message + '</strong><br>👤 ' + notif.customer + '<br>📞 ' + notif.phone + '<br>🔧 ' + notif.service + '</div></div>';
    });
    
    html += '<div style="margin-top: 15px; text-align: center;"><a href="dashboard.php" style="background: white; color: #667eea; padding: 8px 20px; border-radius: 5px; text-decoration: none; font-weight: bold;">View Dashboard</a></div></div>';
    
    document.body.insertAdjacentHTML('beforeend', html);
    
    setTimeout(function() {
        var toast = document.querySelector('.notif-toast');
        if (toast) {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(400px)';
            setTimeout(function() { toast.remove(); }, 500);
        }
    }, 12000);
}
// Check for notifications
function checkNotifications() {
    checkCount++;
    console.log('🔍 [CHECK #' + checkCount + '] Checking notifications...');
    
    fetch('check-technician-notifications.php', { method: 'GET', cache: 'no-cache' })
    .then(function(response) { return response.text(); })
    .then(function(rawResponse) {
        var cleanResponse = rawResponse.trim().replace(/^\uFEFF/, '');
        var response = JSON.parse(cleanResponse);
        
        if (response.error) {
            console.error('❌ Server error:', response.error);
            return;
        }
        
        // Update badge
        var badge = document.getElementById('notificationCount');
        if (badge) {
            if (response.notification_count > 0) {
                badge.textContent = response.notification_count;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }
        }
        
        if (response.has_notifications && response.new_count > 0) {
            console.log('🎉 NEW NOTIFICATIONS: ' + response.new_count);
            
            // Play sound
            playSound();
            
            // Show browser notification
            showBrowserNotif(response.notifications);
            
            // Show toast
            if (!document.hidden) {
                showToast(response.notifications);
            }
            
            // Update UI elements
            var dot = document.getElementById('headerNotifDot');
            if (dot) dot.style.display = 'block';
            
            var mobileAlert = document.getElementById('mobileNotificationAlert');
            var mobileText = document.getElementById('mobileAlertText');
            if (mobileAlert && mobileText) {
                mobileText.textContent = 'You have ' + response.notification_count + ' new notification' + (response.notification_count > 1 ? 's' : '') + '!';
                mobileAlert.style.display = 'flex';
            }
        } else {
            console.log('✓ No new notifications');
        }
    })
    .catch(function(error) {
        console.error('❌ Check failed:', error);
    });
}

// Request notification permission
function requestNotifPermission() {
    if ('Notification' in window && Notification.permission === 'default') {
        console.log('📋 Requesting notification permission...');
        Notification.requestPermission().then(function(permission) {
            console.log('📋 Permission result:', permission);
        });
    }
}

// Handle user interaction
var interactionHandled = false;
function handleInteraction() {
    if (interactionHandled) return;
    interactionHandled = true;
    
    console.log('👆 User interaction detected');
    
    var wasEnabled = localStorage.getItem(AUDIO_KEY);
    var setupDone = localStorage.getItem(SETUP_KEY);
    
    if (wasEnabled === 'true') {
        enableAudio();
    } else if (setupDone !== 'true' && setupDone !== 'skipped') {
        setTimeout(showEnablePrompt, 1500);
    }
    
    requestNotifPermission();
}

// Initialize system
console.log('🎬 Initializing simple notification system...');
initAudio();

// Add interaction listeners
['touchstart', 'click', 'keydown', 'scroll'].forEach(function(event) {
    document.addEventListener(event, handleInteraction, { passive: true, once: true });
});

// Service worker
if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('service-worker.js')
        .then(function(registration) {
            console.log('✅ Service Worker registered');
            requestNotifPermission();
        })
        .catch(function(error) {
            console.error('❌ Service Worker failed:', error);
        });
}

// Page visibility
document.addEventListener('visibilitychange', function() {
    console.log('📱 Page hidden:', document.hidden);
    if (!document.hidden) {
        setTimeout(checkNotifications, 1000);
    }
});

// Initial check and polling
setTimeout(function() {
    fetch('check-technician-notifications.php', { cache: 'no-cache' })
        .then(function(response) { return response.json(); })
        .then(function(response) {
            if (response && response.notification_count > 0) {
                var dot = document.getElementById('headerNotifDot');
                if (dot) dot.style.display = 'block';
            }
        })
        .catch(function(e) { console.error('❌ Initial check error:', e); });
}, 1000);

setInterval(checkNotifications, isMobile ? 6000 : 5000);
setTimeout(checkNotifications, 2000);

// Add CSS
if (!document.getElementById('simple-notif-styles')) {
    var style = document.createElement('style');
    style.id = 'simple-notif-styles';
    style.textContent = '@keyframes slideIn { from { transform: translateX(400px); opacity: 0; } to { transform: translateX(0); opacity: 1; } } .notif-toast { transition: all 0.5s ease; } @media (max-width: 768px) { .notif-toast { right: 10px !important; left: 10px !important; min-width: auto !important; max-width: none !important; } }';
    document.head.appendChild(style);
}

console.log('✅ Simple Notification System Ready');
console.log('📊 Technician ID: ' + TECH_ID);
console.log('📱 Device: ' + (isMobile ? 'Mobile' : 'Desktop'));
console.log('🔄 Polling every ' + (isMobile ? '6' : '5') + ' seconds');
</script>