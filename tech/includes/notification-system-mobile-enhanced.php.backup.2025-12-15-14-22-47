            console.log('✅ [BROWSER-NOTIF] Mobile browser notification shown');
        } catch(e) {
            console.error('❌ [BROWSER-NOTIF] Error:', e);
        }
    });
}

// Request notification permission aggressively for mobile
function requestNotificationPermission() {
    if ('Notification' in window && Notification.permission === 'default') {
        console.log('📋 [PERMISSION] Requesting notification permission for mobile...');
        
        // Show a pre-permission explanation for mobile users
        if (isMobile) {
            const prePrompt = document.createElement('div');
            prePrompt.style.cssText = `
                position: fixed;
                top: 80px;
                left: 50%;
                transform: translateX(-50%);
                background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
                color: white;
                padding: 15px 20px;
                border-radius: 10px;
                box-shadow: 0 5px 15px rgba(59, 130, 246, 0.4);
                z-index: 99999;
                font-weight: bold;
                text-align: center;
                max-width: 90%;
            `;
            prePrompt.innerHTML = '📱 Enable notifications to receive alerts when your phone is locked!';
            document.body.appendChild(prePrompt);
            
            setTimeout(() => {
                prePrompt.remove();
            }, 3000);
        }
        
        Notification.requestPermission().then(permission => {
            localStorage.setItem(NOTIFICATION_PERMISSION_KEY, permission);
            if (permission === 'granted') {
                console.log('✅ [PERMISSION] Mobile notification permission granted!');
            } else {
                console.log('⚠️ [PERMISSION] Mobile notification permission denied');
            }
        });
    }
}

function showNotificationToast(notifications) {
    // Only show toast if page is visible
    if (document.hidden) {
        console.log('📱 [TOAST] Page hidden, skipping toast');
        return;
    }
    
    console.log('📱 [TOAST] Showing mobile notification toast for', notifications.length, 'notifications');
    
    const count = notifications.length;
    document.querySelectorAll('.tech-notification-toast').forEach(el => el.remove());
    
    const firstAction = notifications[0].action;
    let bgColor = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
    let icon = 'bell';
    
    if(firstAction === 'assigned' || firstAction === 'reassigned') {
        bgColor = 'linear-gradient(135deg, #11998e 0%, #38ef7d 100%)';
        icon = 'user-check';
    } else if(firstAction === 'approved') {
        bgColor = 'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)';
        icon = 'check-circle';
    } else if(firstAction === 'hold') {
        bgColor = 'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)';
        icon = 'pause-circle';
    } else if(firstAction === 'resumed') {
        bgColor = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';
        icon = 'play-circle';
    }
    
    let html = `<div class="tech-notification-toast" style="position: fixed; top: 80px; right: 20px; background: ${bgColor}; color: white; padding: 20px; border-radius: 10px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); z-index: 99999; min-width: 300px; max-width: 90%; animation: slideIn 0.5s ease-out;">`;
    html += `<div style="display: flex; align-items: center; margin-bottom: 10px;">`;
    html += `<i class="fas fa-${icon}" style="font-size: 24px; margin-right: 10px;"></i>`;
    html += `<h4 style="margin: 0; font-weight: bold;">${count === 1 ? 'New Notification!' : count + ' New Notifications!'}</h4>`;
    html += `<button onclick="this.parentElement.parentElement.remove()" style="margin-left: auto; background: transparent; border: none; color: white; font-size: 20px; cursor: pointer;">&times;</button>`;
    html += `</div>`;
    
    notifications.forEach(notif => {
        html += `<div style="background: rgba(255,255,255,0.2); padding: 10px; border-radius: 5px; margin-top: 10px;">`;
        html += `<strong>📋 Booking #${notif.id}</strong><br>`;
        html += `<div style="margin-top: 5px; font-size: 13px;">`;
        html += `<strong>✨ ${notif.message}</strong><br>`;
        html += `👤 ${notif.customer}<br>`;
        html += `📞 ${notif.phone}<br>`;
        html += `🔧 ${notif.service}<br>`;
        html += `📊 Status: ${notif.status}`;
        if(notif.deadline_date) {
            html += `<br>⏰ Deadline: ${notif.deadline_date} ${notif.deadline_time || ''}`;
        }
        html += `</div></div>`;
    });
    
    html += `<div style="margin-top: 15px; text-align: center;">`;
    html += `<a href="dashboard.php" style="background: white; color: #667eea; padding: 8px 20px; border-radius: 5px; text-decoration: none; font-weight: bold; display: inline-block;">View Dashboard</a>`;
    html += `</div></div>`;
    
    document.body.insertAdjacentHTML('beforeend', html);
    
    setTimeout(() => {
        const toast = document.querySelector('.tech-notification-toast');
        if (toast) {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(400px)';
            setTimeout(() => toast.remove(), 500);
        }
    }, 12000); // Longer display time for mobile
}

function checkTechNotifications() {
    checkCount++;
    console.log(`🔍 [CHECK #${checkCount}] Starting mobile notification check...`);
    
    fetch('check-technician-notifications.php', { method: 'GET', cache: 'no-cache' })
    .then(response => response.text())
    .then(rawResponse => {
        const cleanResponse = rawResponse.trim().replace(/^\uFEFF/, '');
        const response = JSON.parse(cleanResponse);
        
        if(response.error) {
            console.error('❌ [ERROR] Server error:', response.error);
            return;
        }
        
        // Update badge
        const badge = document.getElementById('notificationCount');
        if(badge) {
            if(response.notification_count > 0) {
                badge.textContent = response.notification_count;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }
        }
        
        if(response.has_notifications && response.new_count > 0) {
            console.log('🎉 [NOTIFICATION] NEW MOBILE NOTIFICATIONS DETECTED!', response.new_count);
            
            // Play sound with multiple methods (works even in background)
            playNotificationSound();
            
            // Show browser notification (works when page is hidden/locked)
            showBrowserNotification(response.notifications);
            
            // Show toast only if page is visible
            if (!document.hidden) {
                showNotificationToast(response.notifications);
            }
            
            // Update UI elements
            const dot = document.getElementById('headerNotifDot');
            if(dot) dot.style.display = 'block';
            
            const mobileAlert = document.getElementById('mobileNotificationAlert');
            const mobileText = document.getElementById('mobileAlertText');
            if(mobileAlert && mobileText) {
                mobileText.textContent = `You have ${response.notification_count} new notification${response.notification_count > 1 ? 's' : ''}!`;
                mobileAlert.style.display = 'flex';
            }
            
            // Send message to service worker for background handling
            if ('serviceWorker' in navigator && navigator.serviceWorker.controller) {
                navigator.serviceWorker.controller.postMessage({
                    type: 'NEW_BOOKING',
                    notifications: response.notifications
                });
            }
        } else {
            console.log('✓ [CHECK] No new mobile notifications');
        }
    })
    .catch(error => {
        console.error('❌ [FETCH] Mobile notification check error:', error);
    });
}

// Initialize system
console.log('🎬 [INIT] Initializing enhanced mobile notification system...');
console.log('📱 [MOBILE] Device detected as:', isMobile ? 'Mobile' : 'Desktop');
initializeAudio();

// Enhanced mobile interaction handling
let autoEnableAttempted = false;

function handleMobileInteraction() {
    if (autoEnableAttempted) return;
    autoEnableAttempted = true;
    
    console.log('👆 [INTERACTION] Mobile interaction detected');
    
    // Check if audio was previously enabled
    const wasEnabled = localStorage.getItem(AUDIO_STORAGE_KEY);
    const setupComplete = localStorage.getItem(AUDIO_SETUP_KEY);
    
    if (wasEnabled === 'true') {
        // Audio was previously enabled - enable it silently
        enableAudioPermanently().then(() => {
            console.log('✅ [INTERACTION] Mobile audio re-enabled from previous session');
        });
    } else if (setupComplete !== 'true' && setupComplete !== 'skipped') {
        // First time - show setup prompt after a short delay
        setTimeout(() => {
            showMobileEnablePrompt();
        }, 1500); // Longer delay for mobile
    }
    
    // Request notification permission
    requestNotificationPermission();
}

// Enhanced interaction listeners for mobile
const mobileEvents = ['touchstart', 'touchend', 'click', 'keydown', 'scroll'];
mobileEvents.forEach(event => {
    document.addEventListener(event, handleMobileInteraction, { passive: true, once: true });
});

// Register enhanced service worker for mobile
if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('service-worker.js')
        .then(registration => {
            console.log('✅ [SW] Enhanced service worker registered for mobile');
            
            // Enhanced mobile notification permission handling
            if (Notification.permission === 'default') {
                // Wait for user interaction before requesting permission
                setTimeout(() => {
                    if (isMobile) {
                        Notification.requestPermission().then(permission => {
                            localStorage.setItem(NOTIFICATION_PERMISSION_KEY, permission);
                            if (permission === 'granted') {
                                console.log('✅ [SW] Mobile background notifications enabled');
                                
                                // Register for background sync
                                if ('sync' in window.ServiceWorkerRegistration.prototype) {
                                    registration.sync.register('check-bookings');
                                    console.log('✅ [SW] Mobile background sync registered');
                                }
                            }
                        });
                    }
                }, 3000);
            }
            
            // Listen for messages from service worker
            navigator.serviceWorker.addEventListener('message', event => {
                console.log('💬 [SW] Message from mobile service worker:', event.data);
                if (event.data.type === 'NEW_BOOKING') {
                    // Service worker found new bookings, refresh our UI
                    setTimeout(checkTechNotifications, 1000);
                }
            });
            
        })
        .catch(error => {
            console.error('❌ [SW] Mobile service worker registration failed:', error);
        });
}

// Initial check with mobile optimization
setTimeout(() => {
    fetch('check-technician-notifications.php', { cache: 'no-cache' })
        .then(response => response.json())
        .then(response => {
            if(response && response.notification_count > 0) {
                const dot = document.getElementById('headerNotifDot');
                if(dot) dot.style.display = 'block';
                const badge = document.getElementById('floatingBadge');
                if(badge) {
                    badge.textContent = response.notification_count;
                    badge.style.display = 'flex';
                }
            }
        })
        .catch(e => console.error('❌ [INIT] Mobile initial check error:', e));
}, 1000);

// Start polling with mobile-optimized interval
setInterval(checkTechNotifications, isMobile ? 6000 : 5000); // Slightly longer interval for mobile to save battery
setTimeout(checkTechNotifications, 2000);

// Add enhanced CSS animations for mobile
if(!document.getElementById('tech-notification-mobile-styles')) {
    const style = document.createElement('style');
    style.id = 'tech-notification-mobile-styles';
    style.textContent = `
        @keyframes slideIn { 
            from { transform: translateX(400px); opacity: 0; } 
