<!-- Enhanced Mobile Notification System - Handles Mobile Audio Restrictions -->
<script>
console.log('🚀 Initializing Enhanced Mobile Notification System v4.0');

let techNotificationAudio = null;
let audioEnabled = false;
let audioInitialized = false;
let checkCount = 0;
let persistentAudioEnabled = false;
let isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
let audioContext = null;
let audioBuffer = null;
let audioSource = null;

// Unique storage key per technician
const TECH_ID = <?php echo $_SESSION['t_id']; ?>;
const AUDIO_STORAGE_KEY = `techAudio_${TECH_ID}_enabled`;
const AUDIO_SETUP_KEY = `techAudio_${TECH_ID}_setup_complete`;
const NOTIFICATION_PERMISSION_KEY = `techNotif_${TECH_ID}_permission`;

// Enhanced audio initialization for mobile
function initializeAudio() {
    console.log('🔊 [AUDIO] Initializing enhanced mobile audio system...');
    
    if (!audioInitialized) {
        try {
            // Method 1: Traditional Audio API
            techNotificationAudio = new Audio('../admin/vendor/sounds/arived.mp3');
            techNotificationAudio.volume = 1.0;
            techNotificationAudio.preload = 'auto';
            techNotificationAudio.load();
            
            // Method 2: Web Audio API for better mobile support
            if (window.AudioContext || window.webkitAudioContext) {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                audioContext = new AudioContextClass();
                
                // Load audio buffer for Web Audio API
                fetch('../admin/vendor/sounds/arived.mp3')
                    .then(response => response.arrayBuffer())
                    .then(data => audioContext.decodeAudioData(data))
                    .then(buffer => {
                        audioBuffer = buffer;
                        console.log('✅ [AUDIO] Web Audio API buffer loaded');
                    })
                    .catch(error => {
                        console.log('⚠️ [AUDIO] Web Audio API buffer load failed:', error);
                    });
            }
            
            audioInitialized = true;
            console.log('✅ [AUDIO] Enhanced audio system initialized');
            
            // Check if audio was previously enabled
            const wasEnabled = localStorage.getItem(AUDIO_STORAGE_KEY);
            if (wasEnabled === 'true') {
                audioEnabled = true;
                persistentAudioEnabled = true;
                console.log('✅ [AUDIO] Audio was previously enabled - ready for mobile playback');
            }
            
        } catch(e) {
            console.error('❌ [AUDIO] Enhanced audio initialization error:', e);
        }
    }
}

// Enhanced audio enable for mobile devices
function enableAudioPermanently() {
    console.log('🔊 [AUDIO] Enabling audio permanently for mobile...');
    
    if (!audioInitialized) initializeAudio();
    
    return new Promise((resolve) => {
        // For mobile devices, we need to unlock audio context first
        if (isMobile && audioContext && audioContext.state === 'suspended') {
            console.log('📱 [MOBILE] Resuming suspended audio context...');
            audioContext.resume().then(() => {
                console.log('✅ [MOBILE] Audio context resumed');
                enableAudioPlayback().then(resolve);
            }).catch(() => {
                enableAudioPlayback().then(resolve);
            });
        } else {
            enableAudioPlayback().then(resolve);
        }
    });
}

function enableAudioPlayback() {
    return new Promise((resolve) => {
        if (techNotificationAudio) {
            // Try traditional audio first
            techNotificationAudio.play().then(() => {
                techNotificationAudio.pause();
                techNotificationAudio.currentTime = 0;
                audioEnabled = true;
                persistentAudioEnabled = true;
                
                // Save permanently for this technician
                localStorage.setItem(AUDIO_STORAGE_KEY, 'true');
                localStorage.setItem(AUDIO_SETUP_KEY, 'true');
                
                console.log('✅ [AUDIO] Traditional audio enabled for technician ID:', TECH_ID);
                
                // Show success message
                if (!document.getElementById('audio-success-msg')) {
                    showSuccessMessage();
                }
                
                resolve(true);
            }).catch((e) => {
                console.log('⚠️ [AUDIO] Traditional audio failed, trying Web Audio API:', e.message);
                
                // Try Web Audio API as fallback
                if (audioContext && audioBuffer) {
                    try {
                        const source = audioContext.createBufferSource();
                        source.buffer = audioBuffer;
                        source.connect(audioContext.destination);
                        source.start(0);
                        source.stop(audioContext.currentTime + 0.1); // Very short test sound
                        
                        audioEnabled = true;
                        persistentAudioEnabled = true;
                        localStorage.setItem(AUDIO_STORAGE_KEY, 'true');
                        localStorage.setItem(AUDIO_SETUP_KEY, 'true');
                        
                        console.log('✅ [AUDIO] Web Audio API enabled for technician ID:', TECH_ID);
                        showSuccessMessage();
                        resolve(true);
                    } catch (webAudioError) {
                        console.log('⚠️ [AUDIO] Web Audio API also failed:', webAudioError.message);
                        resolve(false);
                    }
                } else {
                    resolve(false);
                }
            });
        } else {
            resolve(false);
        }
    });
}

function showSuccessMessage() {
    const msg = document.createElement('div');
    msg.id = 'audio-success-msg';
    msg.style.cssText = `
        position: fixed; 
        top: 80px; 
        left: 50%; 
        transform: translateX(-50%); 
        background: linear-gradient(135deg, #10b981 0%, #059669 100%); 
        color: white; 
        padding: 15px 25px; 
        border-radius: 15px; 
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.4); 
        z-index: 99999; 
        font-weight: bold; 
        display: flex; 
        align-items: center; 
        gap: 10px;
        animation: slideDown 0.5s ease-out;
    `;
    msg.innerHTML = '<i class="fas fa-check-circle" style="font-size: 20px;"></i><span>🔊 Mobile Sound Alerts Enabled!</span>';
    document.body.appendChild(msg);
    
    setTimeout(() => {
        msg.style.transition = 'opacity 0.5s, transform 0.5s';
        msg.style.opacity = '0';
        msg.style.transform = 'translateX(-50%) translateY(-20px)';
        setTimeout(() => msg.remove(), 500);
    }, 3000);
}

let lastSoundPlayTime = 0;
const SOUND_COOLDOWN = 1500; // Reduced cooldown for mobile

// Enhanced sound playback for mobile devices
function playNotificationSound() {
    console.log('🔊 [SOUND] Attempting mobile-optimized sound playback...');
    
    // Prevent duplicate sounds
    const now = Date.now();
    if (now - lastSoundPlayTime < SOUND_COOLDOWN) {
        console.log('⏭️ [SOUND] Skipping - sound played recently');
        return;
    }
    
    if (!audioInitialized) initializeAudio();
    
    // If audio was previously enabled, try multiple playback methods
    if (persistentAudioEnabled || audioEnabled) {
        playAudioMultiMethod();
    } else {
        // First time - show enable prompt
        showMobileEnablePrompt();
    }
}

function playAudioMultiMethod() {
    console.log('🎵 [SOUND] Trying multiple audio playback methods...');
    
    let soundPlayed = false;
    
    // Method 1: Traditional Audio API
    if (techNotificationAudio && !soundPlayed) {
        techNotificationAudio.currentTime = 0;
        techNotificationAudio.volume = 1.0;
        
        const playPromise = techNotificationAudio.play();
        if (playPromise !== undefined) {
            playPromise.then(() => {
                console.log('✅ [SOUND] Traditional audio played successfully!');
                lastSoundPlayTime = Date.now();
                soundPlayed = true;
                
                // Auto-pause after 2 seconds to save battery
                setTimeout(() => {
                    if (techNotificationAudio) {
                        techNotificationAudio.pause();
                        techNotificationAudio.currentTime = 0;
                    }
                }, 2000);
            }).catch((error) => {
                console.log('⚠️ [SOUND] Traditional audio failed:', error.message);
                
                // Method 2: Web Audio API fallback
                if (audioContext && audioBuffer && !soundPlayed) {
                    tryWebAudioPlayback();
                }
            });
        }
    }
    
    // Method 3: Vibration for mobile devices (always works)
    if (isMobile && 'vibrate' in navigator) {
        navigator.vibrate([300, 100, 300, 100, 300]);
        console.log('📳 [MOBILE] Vibration triggered');
    }
    
    // Method 4: Visual flash for additional feedback
    flashScreen();
}

function tryWebAudioPlayback() {
    try {
        if (audioContext.state === 'suspended') {
            audioContext.resume().then(() => {
                playWebAudio();
            });
        } else {
            playWebAudio();
        }
    } catch (error) {
        console.log('⚠️ [SOUND] Web Audio API playback failed:', error.message);
    }
}

function playWebAudio() {
    try {
        const source = audioContext.createBufferSource();
        source.buffer = audioBuffer;
        source.connect(audioContext.destination);
        source.start(0);
        
        console.log('✅ [SOUND] Web Audio API played successfully!');
        lastSoundPlayTime = Date.now();
        
        // Clean up source after playback
        setTimeout(() => {
            try {
                source.disconnect();
            } catch (e) {}
        }, 3000);
    } catch (error) {
        console.log('⚠️ [SOUND] Web Audio source creation failed:', error.message);
    }
}

function flashScreen() {
    // Visual feedback for when sound might not work
    const flash = document.createElement('div');
    flash.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(16, 185, 129, 0.3);
        z-index: 99998;
        pointer-events: none;
        animation: flashAnimation 0.5s ease-out;
    `;
    
    document.body.appendChild(flash);
    
    setTimeout(() => {
        flash.remove();
    }, 500);
}

