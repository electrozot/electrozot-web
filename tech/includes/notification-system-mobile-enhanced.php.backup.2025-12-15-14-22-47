// Enhanced page visibility handling for mobile
document.addEventListener('visibilitychange', function() {
    const isHidden = document.hidden;
    console.log('📱 [VISIBILITY] Page visibility changed, hidden:', isHidden);
    
    // Notify service worker about visibility change
    if ('serviceWorker' in navigator && navigator.serviceWorker.controller) {
        navigator.serviceWorker.controller.postMessage({
            type: 'PAGE_VISIBILITY_CHANGE',
            hidden: isHidden
        });
    }
    
    // Adjust polling frequency based on visibility
    if (isHidden && isMobile) {
        console.log('📱 [BACKGROUND] Entering background mode - notifications will continue via Service Worker');
    } else if (!isHidden) {
        console.log('📱 [FOREGROUND] Returning to foreground mode - resuming normal operation');
        // Do an immediate check when returning to foreground
        setTimeout(checkTechNotifications, 1000);
    }
});

